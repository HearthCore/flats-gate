# flats-gate config (secret - mode 600)
FLATS_UPSTREAM=http://127.0.0.1:7878
FLATS_GATE_BIND=127.0.0.1
FLATS_GATE_CONSOLE_PORT=7880
FLATS_GATE_MCP_PORT=7881
FLATS_GATE_CONSOLE_PUBLIC_URL=https://flats.goetzken.dev
# optional: public MCP hostname, used to rewrite mcp_url in responses
FLATS_GATE_MCP_PUBLIC_URL=
# comma separated; one key per client. Empty = no key check (rely on Pangolin auth)
FLATS_GATE_API_KEYS=
