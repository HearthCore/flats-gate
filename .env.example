# flats-gate config (secret - mode 600)
FLATS_UPSTREAM=http://127.0.0.1:7878
FLATS_GATE_BIND=127.0.0.1
FLATS_GATE_CONSOLE_PORT=7880
FLATS_GATE_MCP_PORT=7881
# Public console URL. Empty = local-only mode (no host/URL rewriting, no public docs).
FLATS_GATE_CONSOLE_PUBLIC_URL=
# optional: public MCP hostname, used to rewrite mcp_url in responses
FLATS_GATE_MCP_PUBLIC_URL=
# comma separated; one key per client. Empty = no key check (rely on Pangolin auth)
FLATS_GATE_API_KEYS=
# Serve the 5 static agent-doc paths (llms.txt, /docs/*.md) without key on the mcp gate, URLs rewritten
# to the public URL. auto = only when FLATS_GATE_CONSOLE_PUBLIC_URL is set; true/false to force.
FLATS_GATE_PUBLIC_DOCS=auto
FLATS_GATE_BLOCK_METRICS=1
# Site gate: serve <slug>.<suffix> (needs a wildcard route in the proxy). Empty = site gate off.
FLATS_GATE_SITE_PUBLIC_SUFFIX=
# public (only flats with visibility=public) | allowlist (FLATS_GATE_SITE_ALLOWLIST file) | all (put SSO in front!)
FLATS_GATE_SITE_POLICY=public
FLATS_GATE_SITE_PORT=7882
